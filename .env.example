# Public site URL — used for metadata, canonical URLs, sitemap, and robots.
NEXT_PUBLIC_SITE_URL="https://www.atlanticfortis.com"

# --- Consultation form email delivery (Hostinger Email API) ---
# The contact form server action (app/actions.ts) sends enquiries through the
# Hostinger Email API. Until all three of the following are set, submissions are
# accepted and logged to the server console instead of emailed.
#
# HOSTINGER_EMAIL_TOKEN         Bearer token authorized for the sending mailbox.
# HOSTINGER_MAILBOX_RESOURCE_ID Resource id of the sending mailbox.
#                               Find it via GET https://api.mail.hostinger.com/api/v1/me
#                               -> data.mailboxes[].resourceId
# CONTACT_TO_EMAIL             Destination inbox for enquiries (e.g. info@atlanticfortis.com).
# CONTACT_FROM_DISPLAY_NAME    Optional display name on the outgoing message.
#
# Note: the sending mailbox belongs to whatever domain the token is issued for.
# For best deliverability that should be an atlanticfortis.com mailbox so SPF/DKIM
# align. The visitor's address is always set as Reply-To.
HOSTINGER_EMAIL_TOKEN=""
HOSTINGER_MAILBOX_RESOURCE_ID=""
CONTACT_TO_EMAIL="info@atlanticfortis.com"
CONTACT_FROM_DISPLAY_NAME="Atlantic Fortis Website"
